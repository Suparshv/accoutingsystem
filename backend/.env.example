# Backend environment template. Copy to backend/.env (gitignored) and adjust.
# Mirrors the backend section of the repository-root .env.example.
# See SPEC.md §5 for the description of each variable.

# SQLAlchemy URL for the Postgres container in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://admin:admin123@localhost:5432/urbanfurniture

# JWT signing. Replace JWT_SECRET with a real secret outside local development.
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Directory for uploaded attachments, relative to backend/.
UPLOAD_DIR=./uploads
